# ============================================================
# 로컬 개발용 환경 변수 (cp .env.example .env 후 값 채우기, .env 는 git 에 올리지 않는다)
# 값 뒤에 # 주석을 달지 말 것 (systemd EnvironmentFile 과 docker compose 가 주석까지 값으로 읽을 수 있다)
# ============================================================

# --- PostgreSQL (docker-compose.yml 의 postgres 컨테이너) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crypto
POSTGRES_USER=crypto
POSTGRES_PASSWORD=crypto

# --- NVIDIA NIM (뉴스 분류, 투자 대가 의견, 위원장 해설). 비우면 LLM 단계는 건너뛰고 계량 결과만 낸다 ---
# 키는 midas-touch/.env 의 NVIDIA_API_KEY, NVIDIA_API_KEY_2 를 복사한다 (키당 분당 40회)
NVIDIA_API_KEY=
NVIDIA_API_KEY_2=
# 비우면 nvidia/nemotron-3.5-super-vl-120b-a12b, 실패하면 대체 모델로 한 번 더
NIM_MODEL=
NIM_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# --- 실행 버튼 비밀번호 (비우면 실행이 막힌다. 결과 보기는 비밀번호 없이 된다) ---
APP_PASSWORD=dev
