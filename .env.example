# ============================================================
# 환경 변수 예시 파일
# 사용법: 이 파일을 .env 로 복사한 뒤 값만 채우면 된다.
#   cp .env.example .env
# docker-compose.yml 과 각 서비스가 이 값들을 읽어간다.
# ============================================================

# --- 거래소 / Producer 설정 ---
# 구독할 거래소 (현재 producer는 upbit 구현)
EXCHANGE=upbit
# 수집할 심볼 목록 (쉼표로 구분). Upbit는 "KRW-BTC" 형식.
SYMBOLS=KRW-BTC,KRW-ETH,KRW-XRP

# --- Kafka 설정 ---
# 컨테이너 내부에서 접속할 때 쓰는 주소 (서비스명:포트)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# 체결 이벤트가 쌓이는 토픽 이름
KAFKA_TOPIC=crypto-trades

# --- PostgreSQL 설정 ---
POSTGRES_USER=crypto
POSTGRES_PASSWORD=crypto
POSTGRES_DB=crypto
# 백엔드/스파크가 DB에 접속할 주소
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
