# ============================================================
# 프로덕션(.env) 예시 — Oracle VM 에서 사용
# 사용법: VM의 repo 루트에서  cp .env.prod.example .env  후 값 채우기.
# 이 값들은 docker-compose.prod.yml 이 읽는다. 실제 .env 는 git 에 커밋 금지.
# ============================================================

# --- GHCR 이미지 (publish-images 워크플로가 올린 것) ---
# <owner>/<repo> 소문자. 예: ghcr.io/jacob-9909/kaspflow
IMAGE_PREFIX=ghcr.io/<owner>/<repo>
# latest 또는 특정 커밋 sha- 태그 (예: sha-1a2b3c4)
IMAGE_TAG=latest

# --- Kafka / Producer ---
KAFKA_TOPIC=crypto-trades
SYMBOLS=BTCUSDT,ETHUSDT,XRPUSDT

# --- News Collector (docs/news-signal-design.md) ---
NEWS_TOPIC=news-raw
# 피드별 폴링 주기(초)
NEWS_POLL_SECONDS=300
# 비우면 코드의 기본 피드 목록(CoinDesk, Cointelegraph, The Block, Decrypt, Bitcoin Magazine)을 쓴다.
# 바꾸려면 "source|url[|lang]" 항목을 ';' 로 구분 (같은 사이트의 여러 피드는 같은 source 이름).
# 예) NEWS_FEEDS=coindesk|https://www.coindesk.com/arc/outboundfeeds/rss/?outputType=xml;decrypt|https://decrypt.co/feed
NEWS_FEEDS=

# --- Signal Worker (docs/news-signal-design.md) ---
# M2: false = 저장 전용(모델 없음, 300m). M3: true + Laya 포함 이미지(INSTALL_LAYA=1) + 아래 메모리 상한 상향.
LAYA_ENABLED=false
# 맥 실측(2026-10-16): 모델 로드 순간 최대 ~2.8GB, 상주 ~2.1GB. VM 에서 docker stats 로 실측해 조정한다.
SIGNAL_WORKER_MEM_LIMIT=300m
LAYA_CHECKPOINT=convaiinnovations/laya
LAYA_THREADS=2
# 종목 매칭이 없는 기사를 시장 전체(MARKET) 기사로 인정하는 확률 하한 (M0 에서 과발동 관찰 -> 보수적 기본값)
LAYA_MARKET_MIN_P=0.9

# --- 호스트 네이티브 PostgreSQL 17 접속 ---
# 컨테이너에서 호스트로 붙는 특수 호스트명 (compose의 extra_hosts로 매핑됨)
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=crypto
POSTGRES_USER=crypto
# 반드시 강한 값으로 채울 것 (비우면 compose가 거부한다)
POSTGRES_PASSWORD=

# --- Backend 호스트 포트 ---
# 기본 8000. 호스트의 8000 을 다른 서비스가 쓰면 바꾼다 (Oracle VM: midas-touch 가 8000 사용 -> 8010).
# compose 파일을 직접 고치지 말고 여기서 바꿀 것: 자동배포 롤백(git reset --hard)이 파일 수정을 지운다.
# 자동배포의 헬스체크(infra/kaspflow-autodeploy.sh)도 이 값을 읽는다. Caddy 의 /api/* 업스트림과 같아야 한다.
BACKEND_HOST_PORT=8000
