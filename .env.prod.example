# ============================================================
# 프로덕션 .env 예시 (oracle_vm 의 ~/kaspflow/.env). docker-compose.prod.yml 과 자동배포 스크립트가 읽는다.
# 사용법: cp .env.prod.example .env 후 값 채우기. git 에 올리지 않는다. 값 뒤에 # 주석 금지.
# ============================================================

# --- GHCR 이미지 (publish-images 워크플로가 올림). 자동배포는 커밋별 sha- 태그를 직접 넘긴다 ---
IMAGE_PREFIX=ghcr.io/jacob-9909/kaspflow
IMAGE_TAG=latest

# --- backend 가 호스트에 여는 포트 (127.0.0.1). midas-touch 가 8000 을 써서 8010. Caddy /api 업스트림과 같아야 한다 ---
BACKEND_HOST_PORT=8010

# --- 호스트 네이티브 PostgreSQL 17 (crypto DB, 앱 테이블은 stock 스키마에 자동 생성) ---
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=crypto
POSTGRES_USER=crypto
POSTGRES_PASSWORD=

# --- NVIDIA NIM (midas-touch/.env 에서 복사) ---
NVIDIA_API_KEY=
NVIDIA_API_KEY_2=
NIM_MODEL=
NIM_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# --- 실행 버튼 비밀번호 (강한 값으로) ---
APP_PASSWORD=
# 로그인 쿠키 서명 키 (openssl rand -hex 32). 비우면 재시작할 때마다 다시 로그인해야 한다
SESSION_SECRET=
